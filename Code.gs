/**
 * @OnlyCurrentDoc
 * School Timetable Management System
 * Entry Point and UI
 */

function onOpen() {
  // Refresh already re-applies dropdowns, styling, tab order and the full Master Grid,
  // and Setup also (re)installs the edit sync trigger, so those have no items of their own.
  SpreadsheetApp.getUi().createMenu('Timetable System')
    .addItem('🔄 Refresh All Views', 'refreshAllViews')
    .addItem('✅ Check For Conflicts', 'runValidation')
    .addItem('👥 Cover Manager', 'openCoverManagerUI')
    .addSeparator()
    .addItem('📥 Import Timetable', 'importExcelData')
    .addItem('💾 Save Snapshot', 'saveCurrentSheetAsPrefillData')
    .addSeparator()
    .addItem('⚙️ Setup / Repair', 'setupInitialSpreadsheet')
    .addToUi();
}

/**
 * Refreshes all timetable views and dashboards (Class View, Teacher View, Teacher Day View, Master Grid View).
 * Re-applies validation dropdowns and styling across the entire workbook.
 * @param {boolean} [silent=false] When true, suppresses the completion UI alert.
 */
function refreshAllViews(silent) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const S = CONFIG.SHEETS;

  // 1. Re-apply Master Schedule Dropdowns
  applyMasterScheduleDropdowns_(/* silent= */ true);

  // 2. Refresh Class View (keep the selected class if it still exists)
  const classViewSheet = ss.getSheetByName(S.CLASS_VIEW);
  const classNames = getClassNames_();
  let activeClass = classViewSheet && classViewSheet.getLastRow() >= 3 ? String(classViewSheet.getRange('B3').getValue() || '') : '';
  if (!activeClass && classNames.length > 0) activeClass = classNames[0];
  if (activeClass) ClassViewManager.renderClassView(activeClass);

  // 3. Refresh Teacher View (falls back to the first teacher if the selected one was removed)
  const teacherViewSheet = ss.getSheetByName(S.TEACHER_VIEW);
  const activeTeacher = teacherViewSheet && teacherViewSheet.getLastRow() >= 3 ? teacherViewSheet.getRange('B3').getValue() : '';
  if (getTeacherNames_().length > 0) TeacherViewManager.renderTeacherView(activeTeacher);

  // 4. Refresh Day-wise Teacher View
  const teacherDayViewSheet = ss.getSheetByName(S.TEACHER_DAY_VIEW);
  let activeDay = CONFIG.DAYS[0];
  let activeClassFilter = CONFIG.ALL_CLASSES;
  if (teacherDayViewSheet && teacherDayViewSheet.getLastRow() >= 3) {
    activeDay = teacherDayViewSheet.getRange('B3').getValue() || CONFIG.DAYS[0];
    activeClassFilter = teacherDayViewSheet.getRange('E3').getValue() || CONFIG.ALL_CLASSES;
  }
  TeacherDayViewManager.renderTeacherDayView(activeDay, activeClassFilter);

  // 4b. Teachers → "Total Hours Scheduled" (periods per week)
  DataAccess.updateTeacherLoad();

  // 4c. Lets the optional read-only web page (WebApp.gs) find this spreadsheet
  rememberSpreadsheetId_();

  // 5. Rebuild the Master Grid with full styling. The data-only refresh (used by onEdit)
  //    keeps the old row colours, which no longer line up once classes are added or removed.
  generateMasterGrid(/* silent= */ true);

  // 6. Reorder tabs (Teachers, Subjects, Classes, Master_Schedule, then all Views)
  reorderSheets();

  // 7. Style entire sheet silently
  styleEntireSheet(/* silent= */ true);

  // 8. Tabs the script rebuilds: typing there is lost at the next refresh, so warn first
  protectGeneratedSheets_();

  if (!silent) {
    SpreadsheetApp.getUi().alert('All Timetable Views & Tabs refreshed successfully!');
  }
}

/**
 * Adds a warning-only protection to the tabs the script regenerates (Master Grid,
 * Change_Log). Editors can still type there after confirming,
 * but Sheets warns them first that the change will not be kept.
 */
function protectGeneratedSheets_() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const S = CONFIG.SHEETS;
  const note = 'Generated by the timetable script — edits here are replaced at the next refresh. Edit Master_Schedule or a view instead.';
  [S.MASTER_GRID, S.CHANGE_LOG].forEach(name => {
    const sheet = ss.getSheetByName(name);
    if (!sheet) return;
    try {
      const existing = sheet.getProtections(SpreadsheetApp.ProtectionType.SHEET);
      const p = existing.length ? existing[0] : sheet.protect();
      p.setWarningOnly(true).setDescription(note);
    } catch (err) {
      // A viewer, or an account that may not change protections: the tab just stays unprotected
    }
  });
}

/** Zebra colour of a data-tab row (sheet row number): even rows tinted, odd rows white. */
function tableRowColor_(row) {
  return row % 2 === 0 ? '#F8F9FA' : '#FFFFFF';
}

/** Background of a Clash Status cell that has a conflict written in it. */
const CLASH_CELL_COLOR = '#FDEDEC';

/**
 * Styles the plain data tabs (Teachers, Subjects, Classes, Master_Schedule, Cover_Manager):
 * dark header, zebra rows, thin borders, one font. The body is styled down to the end of
 * the sheet, with CONFIG.TABLE_SPARE_ROWS spare rows below the data, so rows added later
 * by view edits, imports or the Cover Manager look the same as the rest. Gridlines are hidden, so the
 * borders are what keep the cells readable. Clash Status highlights are kept.
 * The view tabs style themselves and are skipped.
 * @param {boolean} [silent=false] When true, suppresses the completion UI alert.
 */
function styleEntireSheet(silent) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const S = CONFIG.SHEETS;
  // Only the timetable's own data tabs: the view tabs style themselves, and tabs the owner
  // added (exam duty, notes, copies) are left exactly as they are
  const dataSheets = [S.TEACHERS, S.SUBJECTS, S.CLASSES, S.SCHEDULE, S.COVER, S.CHANGE_LOG];

  ss.getSheets().forEach(sheet => {
    const name = sheet.getName();
    if (dataSheets.indexOf(name) === -1) return;
    sheet.setHiddenGridlines(true);

    const lastCol = sheet.getLastColumn();
    if (lastCol === 0) return;

    sheet.getRange(1, 1, 1, lastCol)
      .setFontFamily(CONFIG.FONT)
      .setFontWeight('bold')
      .setFontColor('#FFFFFF')
      .setBackground('#2C3E50')
      .setHorizontalAlignment('center')
      .setVerticalAlignment('middle')
      .setWrap(true)
      .setBorder(true, true, true, true, true, true, '#1A252F', SpreadsheetApp.BorderStyle.SOLID);
    sheet.setFrozenRows(1);

    // Style to the end of the grid, with spare rows below the data for rows added later
    const maxRows = sheet.getMaxRows();
    const wanted = sheet.getLastRow() + CONFIG.TABLE_SPARE_ROWS;
    if (wanted > maxRows) sheet.insertRowsAfter(maxRows, wanted - maxRows);
    const bodyRows = Math.max(maxRows, wanted) - 1;
    if (bodyRows < 1) return;
    const body = sheet.getRange(2, 1, bodyRows, lastCol);
    body.setFontFamily(CONFIG.FONT)
        .setFontColor('#2C3E50')
        .setFontWeight('normal')
        .setVerticalAlignment('middle')
        .setBorder(true, true, true, true, true, true, '#D5D8DC', SpreadsheetApp.BorderStyle.SOLID);

    // Clash Status keeps its red highlight (styling used to wipe it on every refresh)
    const clashCol = name === S.SCHEDULE && lastCol >= CONFIG.COL.CLASH && isClashStatusColumn_(sheet) ? CONFIG.COL.CLASH : 0;
    const status = clashCol ? sheet.getRange(2, clashCol, bodyRows, 1).getValues() : null;
    const bgColors = [];
    for (let i = 0; i < bodyRows; i++) {
      const row = Array(lastCol).fill(tableRowColor_(i + 2));
      if (status && String(status[i][0]).trim()) row[clashCol - 1] = CLASH_CELL_COLOR;
      bgColors.push(row);
    }
    body.setBackgrounds(bgColors);
  });

  if (!silent) {
    SpreadsheetApp.getUi().alert('Global styling applied to all standard data tabs!');
  }
}

/**
 * Creates all required tabs and headers if they don't already exist.
 * Safe to run multiple times — existing sheets are left untouched.
 */
function setupInitialSpreadsheet() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();

  const S = CONFIG.SHEETS;
  const requiredSheets = [
    {
      name: S.TEACHERS,
      headers: ['Teacher Name', 'Subject Specialization', 'Max Hours / Week', 'Days Unavailable', 'Total Hours Scheduled']
    },
    {
      name: S.SUBJECTS,
      headers: ['Subject Name']
    },
    {
      name: S.CLASSES,
      headers: ['Class Name', 'Academic Tier', 'Room Assigned']
    },
    {
      name: S.SCHEDULE,
      headers: CONFIG.SCHEDULE_HEADERS
    },
    {
      name: S.CLASS_VIEW,
      headers: []   // rendered programmatically by ClassViewManager
    },
    {
      name: S.TEACHER_VIEW,
      headers: []   // rendered programmatically by TeacherViewManager
    },
    {
      name: S.TEACHER_DAY_VIEW,
      headers: []   // rendered programmatically by TeacherDayViewManager
    },
    {
      name: S.COVER,
      headers: ['Date', 'Absent Teacher', 'Period', 'Class to Cover', 'Suggested Available Teachers', 'Assigned Cover Teacher']
    }
  ];

  const headerWarnings = [];
  // The retired free/busy grid is generated output; it is renamed and hidden rather than
  // deleted, in case someone typed notes there
  const legacyGrid = ss.getSheetByName(CONFIG.SHEETS.LEGACY_AVAILABILITY);
  if (legacyGrid && !ss.getSheetByName(CONFIG.SHEETS.LEGACY_AVAILABILITY_RETIRED)) {
    legacyGrid.setName(CONFIG.SHEETS.LEGACY_AVAILABILITY_RETIRED);
    legacyGrid.hideSheet();
    headerWarnings.push('the old "' + CONFIG.SHEETS.LEGACY_AVAILABILITY + '" tab is no longer used: it was renamed "' +
      CONFIG.SHEETS.LEGACY_AVAILABILITY_RETIRED + '" and hidden (delete it when you no longer need it)');
  }
  requiredSheets.forEach(sheetInfo => {
    let sheet = ss.getSheetByName(sheetInfo.name);
    const isNew = !sheet;
    if (!sheet) {
      sheet = ss.insertSheet(sheetInfo.name);
    }
    if (sheetInfo.headers.length > 0) {
      if (isNew) {
        sheet.getRange(1, 1, 1, sheetInfo.headers.length).setValues([sheetInfo.headers]);
        sheet.autoResizeColumns(1, sheetInfo.headers.length);
        for (let i = 1; i <= sheetInfo.headers.length; i++) {
          sheet.setColumnWidth(i, sheet.getColumnWidth(i) + 50);
        }
      } else {
        headerWarnings.push.apply(headerWarnings, repairHeaders_(sheet, sheetInfo.headers, sheetInfo.name === S.SCHEDULE));
      }
    }
  });

  styleEntireSheet(/* silent= */ true);

  // Reorder sheets to the correct tab order
  reorderSheets();

  // Apply dropdowns to Master_Schedule
  applyMasterScheduleDropdowns_(/* silent= */ true);

  // Initialize views with first available data
  const classNames = getClassNames_();
  if (classNames.length > 0) ClassViewManager.renderClassView(classNames[0]);
  const teacherNames = getTeacherNames_();
  if (teacherNames.length > 0) TeacherViewManager.renderTeacherView(teacherNames[0]);
  TeacherDayViewManager.renderTeacherDayView(CONFIG.DAYS[0]);

  rememberSpreadsheetId_();

  // Installable edit trigger (no 30-second limit, processes each edit once)
  let triggerNote = 'Edit sync trigger installed.';
  try {
    installEditTrigger_();
  } catch (err) {
    triggerNote = 'Could not install the edit sync trigger (' + err.message + '). Run ⚙️ Setup / Repair again.';
  }

  const hasData = scheduleRowCount_() > 0;
  SpreadsheetApp.getUi().alert(
    'Setup Complete!\n' +
    'Tabs created: Teachers, Subjects, Classes, Master_Schedule, Class_View, Teacher_View, Teacher_Day_View, Cover_Manager.\n' +
    triggerNote + '\n\n' +
    (headerWarnings.length ? '⚠️ Please note:\n• ' + headerWarnings.join('\n• ') + '\n\n' : '') +
    (hasData
      ? 'Your timetable data was not changed. Next step: run 🔄 Refresh All Views.\n' +
        '(Do not run 📥 Import Timetable — it replaces the data with the Excel timetable.)'
      : 'Next step: run 📥 Import Timetable to load the timetable.')
  );
}

/**
 * Fills in missing headers on an existing tab without renaming anything the owner typed.
 *  - a blank header cell gets the expected name
 *  - a different name is left alone and reported
 *  - a header missing from the whole row is added after the last column, except on
 *    Master_Schedule, whose columns are read by position (it is only reported there)
 * @returns {string[]} warnings for the Setup message
 */
function repairHeaders_(sheet, headers, positional) {
  const width = Math.max(sheet.getLastColumn(), headers.length);
  const row = sheet.getRange(1, 1, 1, width).getValues()[0];
  const norm = v => String(v == null ? '' : v).trim().toLowerCase();
  const warnings = [];
  let next = sheet.getLastColumn() + 1;
  headers.forEach((h, i) => {
    if (norm(row[i]) === norm(h)) return;
    if (norm(row[i]) === '' && row.map(norm).indexOf(norm(h)) === -1) {
      sheet.getRange(1, i + 1).setValue(h);
      row[i] = h;
      return;
    }
    if (row.map(norm).indexOf(norm(h)) !== -1) {
      if (positional) warnings.push(sheet.getName() + ': "' + h + '" should be column ' + columnLetter_(i + 1) + ' (found "' + row[i] + '" there)');
      return;
    }
    if (positional) {
      warnings.push(sheet.getName() + ': column ' + columnLetter_(i + 1) + ' is "' + row[i] + '", expected "' + h +
        '" — the timetable reads this tab by column position, so move your column to the right of "' + headers[headers.length - 1] + '"');
      return;
    }
    sheet.getRange(1, next).setValue(h);
    warnings.push(sheet.getName() + ': added "' + h + '" in column ' + columnLetter_(next) + ' (column ' + columnLetter_(i + 1) + ' is "' + row[i] + '")');
    next++;
  });
  return warnings;
}

/** 1 → "A", 27 → "AA". */
function columnLetter_(n) {
  let s = '';
  for (; n > 0; n = Math.floor((n - 1) / 26)) s = String.fromCharCode(65 + (n - 1) % 26) + s;
  return s;
}

// ─────────────────────────────────────────────────────────────────────────────
// MASTER SCHEDULE DROPDOWNS
// ─────────────────────────────────────────────────────────────────────────────

/**
 * Applies data-validation dropdowns to the Subject (col E) and Teacher (col F)
 * columns of the Master_Schedule sheet, mirroring the Class_View behaviour.
 *
 * - Subjects sourced from the Subjects sheet (falls back to unique values already
 *   present in Master_Schedule).
 * - Teachers sourced from the Teachers sheet.
 * - Both rules use setAllowInvalid(true) so existing free-text values are kept.
 *
 * @param {boolean} silent  When true, no UI alert is shown (used during setup).
 */
function applyMasterScheduleDropdowns_(silent) {
  const ss       = SpreadsheetApp.getActiveSpreadsheet();
  const msSheet  = ss.getSheetByName(CONFIG.SHEETS.SCHEDULE);
  if (!msSheet) return;

  const lastRow = msSheet.getLastRow();
  if (lastRow < 2) {
    if (!silent) SpreadsheetApp.getUi().alert('Master Schedule has no data rows yet.');
    return;
  }

  const dataRowCount = lastRow - 1; // exclude header

  // ── Subjects list ─────────────────────────────────────────────────────────
  let subjectsList = DataAccess.getSheetDataAsObjects(CONFIG.SHEETS.SUBJECTS)
                               .map(r => r['Subject Name']).filter(s => s);
  if (subjectsList.length === 0) {
    // Fallback: derive from existing values in col E (Subject)
    const colE = msSheet.getRange(2, 5, dataRowCount, 1).getValues();
    subjectsList = [...new Set(colE.flat().filter(v => v))].sort();
  }

  // ── Teachers list ─────────────────────────────────────────────────────────
  const teachersList = getTeacherNamesSorted_(); // A→Z, easier to find a name

  // ── Build validation rules ────────────────────────────────────────────────
  const subjectRule = subjectsList.length > 0
    ? SpreadsheetApp.newDataValidation()
        .requireValueInList(subjectsList, true)
        .setAllowInvalid(true)
        .build()
    : null;

  const teacherRule = teachersList.length > 0
    ? SpreadsheetApp.newDataValidation()
        .requireValueInList(teachersList, true)
        .setAllowInvalid(true)
        .build()
    : null;

  // ── Apply to columns E (Subject) and F (Teacher) ─────────────────────────
  const subjectRange = msSheet.getRange(2, 5, dataRowCount, 1); // col E
  const teacherRange = msSheet.getRange(2, 6, dataRowCount, 1); // col F

  if (subjectRule) {
    subjectRange.setDataValidation(subjectRule);
  } else {
    subjectRange.clearDataValidations();
  }

  if (teacherRule) {
    teacherRange.setDataValidation(teacherRule);
  } else {
    teacherRange.clearDataValidations();
  }

  if (!silent) {
    SpreadsheetApp.getUi().alert(
      'Dropdowns applied!\n' +
      'Subject column: ' + (subjectsList.length > 0 ? subjectsList.length + ' options' : 'no list found') + '\n' +
      'Teacher column: ' + (teachersList.length > 0 ? teachersList.length + ' options' : 'no list found')
    );
  }
}

/**
 * Reorders the spreadsheet tabs: Teachers, Subjects, Classes, Master_Schedule, followed by all Views.
 * Public menu entry point.
 */
function reorderSheets() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const S = CONFIG.SHEETS;
  const desiredOrder = [
    S.TEACHERS, S.SUBJECTS, S.CLASSES, S.SCHEDULE, S.CLASS_VIEW, S.TEACHER_VIEW,
    S.TEACHER_DAY_VIEW, S.MASTER_GRID, S.COVER, S.CHANGE_LOG
  ];

  // moveActiveSheet() needs each sheet activated; remember where the user was
  // and return them there (previously every refresh left them on the last tab).
  const original = ss.getActiveSheet();
  let currentPos = 1;
  desiredOrder.forEach(name => {
    const sheet = ss.getSheetByName(name);
    if (!sheet) return;
    const atPos = ss.getSheets()[currentPos - 1];
    if (!atPos || atPos.getName() !== name) {
      ss.setActiveSheet(sheet);
      ss.moveActiveSheet(currentPos);
    }
    currentPos++;
  });
  if (original) ss.setActiveSheet(original);
}
